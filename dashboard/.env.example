# Content Operations Dashboard — environment template.
# Copy to .env.local (local dev) or set as secrets in Cloudflare (web).
# NEVER commit real values.

# Deployment mode: "local" (default — execute the real pipeline on this
# machine) or "web" (Cloudflare — execution requests become queued intents).
DEPLOY_MODE=local

# YouTube analytics: OAuth token JSON as ONE string, same shape as the
# pipeline's youtube-tokens.json.
YT_TOKENS_JSON=

# Meta analytics (Facebook Page + Instagram).
META_PAGE_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
META_GRAPH_VERSION=v21.0

# Heartbeat feed consumed by /api/status and the Analytics tab.
HEARTBEAT_URL=https://bolealabs.site/status.json

# Optional: where intents.jsonl / jobs.json / keys.json live (local mode).
# DASH_DATA_DIR=
# PIPELINE_ROOT=
